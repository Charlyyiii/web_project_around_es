{
  "compilerOptions": {
    "target": "ES2015",
    "module": "ES6",
    "lib": ["DOM", "ES2015"],
    "rootDir": "./src",
    "outDir": "./public",
    "strict": true,
    "noImplicitAny": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
